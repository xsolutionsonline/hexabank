# Base de datos por defecto (postgres o sqlite)
DB_TYPE=postgres

# Credenciales de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hexabank

# Si usas SQLite
# DB_DATABASE=hexabank.db

# Configuración de Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=accounts-service
KAFKA_CONSUMER_GROUP_ID=accounts-consumer