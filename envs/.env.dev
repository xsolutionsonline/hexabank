PORT=3000 # Dentro del contenedor sigue siendo 3000
APP_NAME=HexaBank-Core-Docker-Dev

# Base de datos por defecto (postgres o sqlite)
DB_TYPE=postgres
# IMPORTANTE: Cambiamos localhost por el nombre del servicio en docker-compose
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hexabank_dev

# IMPORTANTE: Kafka dentro de la red de Docker usa el puerto interno
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=accounts-service-docker
KAFKA_CONSUMER_GROUP_ID=accounts-consumer-docker